# Database Connection
# PostgreSQL database URL (e.g., Neon or Supabase connection string)
DATABASE_URL=""

# Authentication (NextAuth / Auth.js)
# Generated 32-character random string (e.g., via `npx auth secret`)
AUTH_SECRET=""

# Google OAuth Client Credentials (obtained from Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=""

# Application URLs
# Next.js backend uses these to construct redirect links back to the frontend.
# Set to the public domain in production (e.g., https://ambit-app.onrender.com).
FRONTEND_URL=""
APP_URL=""

# Server Configuration
# The exposed port for the public Express server (injected by host in production)
PORT=""

# Node environment indicator (development or production)
NODE_ENV=""
